---
import Button from './Button.astro';
interface Props { title?: string; description?: string; href?: string; }
const { title = '매장 이벤트로도 만들어보세요', description = '게임을 고객 이벤트로 바꿔 경품과 쿠폰을 함께 운영할 수 있어요.', href = '#business' } = Astro.props;
---
<aside class="card business-cta" aria-labelledby="business-cta-title"><h2 class="card__title" id="business-cta-title">{title}</h2><p>{description}</p><Button href={href} variant="business">이벤트 알아보기</Button></aside>
