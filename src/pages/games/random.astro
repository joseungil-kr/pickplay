---
import GameShell from '../../components/GameShell.astro';
import GameStage from '../../components/GameStage.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="랜덤 이름 뽑기 | PickPlay" description="이름을 넣고 필요한 인원을 간단히 뽑아보세요.">
  <GameShell title="랜덤 이름 뽑기" description="참가자 중 필요한 인원을 빠르게 뽑아보세요." players="2명 이상" duration="약 30초" steps={['참가자 이름을 넣어요.', '뽑을 인원을 고르세요.', '뽑기 버튼을 눌러요.']} relatedGames={[{ name: '행운의 룰렛', description: '돌려서 한 명을 뽑아요.', href: '/play' }]} variant="production" resultInStage>
    <div slot="settings" class="picker-game" data-random-picker>
      <form class="wheel-form" data-picker-form><label for="picker-name">참가자 이름</label><div class="wheel-form__row"><input id="picker-name" data-picker-input type="text" maxlength="16" placeholder="예: 민지" autocomplete="off" /><button class="button button--secondary" type="submit">추가</button></div></form>
      <ul class="wheel-players" data-picker-list aria-label="참가자 목록"></ul>
      <div class="picker-options"><label>뽑을 인원 <select data-picker-count><option value="1">1명</option><option value="2">2명</option><option value="3">3명</option></select></label><label class="wheel-exclude"><input data-picker-exclude type="checkbox" checked /> 뽑힌 사람은 다음 뽑기에서 제외</label></div>
    </div>
    <GameStage slot="game" gameId="random-picker" label="랜덤뽑기 실행 영역">
      <p slot="utility" class="picker-status" data-picker-status role="status"></p>
      <div slot="game" class="picker-stage"><p class="picker-candidate" data-picker-candidate aria-live="polite">?</p></div>
      <button slot="action" class="button button--primary" type="button" data-picker-pick>뽑기</button>
      <div slot="result"><div class="wheel-result" data-picker-result aria-live="polite"></div><p class="picker-remaining" data-picker-remaining aria-live="polite"></p><p class="wheel-history" data-picker-history aria-live="polite"></p></div>
    </GameStage>
    <div slot="actions" class="wheel-actions"><button class="button button--secondary game-shell__action" type="button" data-picker-replay>다시 하기</button><button class="button button--ghost game-shell__action" type="button" data-picker-share>공유하기</button></div>
  </GameShell>
  <script src="../../scripts/random-picker-game.ts"></script>
</BaseLayout>